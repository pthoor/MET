<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>MET.CheckResult</Name>
      <ViewSelectedBy>
        <TypeName>MET.CheckResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>CheckId</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>Category</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Severity</Label><Width>13</Width></TableColumnHeader>
          <TableColumnHeader><Label>Result</Label><Width>13</Width></TableColumnHeader>
          <TableColumnHeader><Label>AffectedObject</Label><Width>28</Width></TableColumnHeader>
          <TableColumnHeader><Label>Finding</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>CheckId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Category</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Severity</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Result</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AffectedObject</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Finding</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
